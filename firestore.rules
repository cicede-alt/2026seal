rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 쓰기·삭제는 로그인한 사용자만. 읽기는 로그인한 사용자 전체 + 누구나 '소품'(kind == 'props')만.
    // 이미지(data URL)가 들어 있어 문서는 900KB 미만으로 제한합니다.
    match /items/{id} {
      allow read: if request.auth != null || resource.data.kind == 'props';
      allow write: if request.auth != null
        && request.resource.size() < 900000;
      allow delete: if request.auth != null;
    }
    // 연습·공연 일정: 누구나 읽고, 쓰기·삭제는 로그인한 사용자만.
    match /schedule/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
